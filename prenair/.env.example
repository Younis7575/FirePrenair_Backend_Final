# Every setting settings.py reads from the environment.
#
# The real .env lives ONLY on the server, next to manage.py, and is never
# committed. This file is the checklist: each deploy compares the server's .env
# against these key names and says plainly which ones are missing, so a release
# that needs a new setting fails loudly here instead of with a 500 in front of
# a user.
#
# Values below are placeholders. Copy this file to .env on the server and fill
# it in; leave a key out only if the feature it powers is genuinely unused.

# --- Django core -----------------------------------------------------------
DJANGO_SECRET_KEY=
SITE_URL=https://fireprenair.com

# --- PostgreSQL ------------------------------------------------------------
# settings.py switches to PostgreSQL when DB_NAME is set, sqlite otherwise.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# --- Channels / websockets -------------------------------------------------
REDIS_HOST=

# --- Email -----------------------------------------------------------------
EMAIL_HOST_PASSWORD=
SENDGRID_API_KEY=

# --- Payments --------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_COURSE=
STRIPE_WEBHOOK_SECRET_GIG_ORDER=
STRIPE_WEBHOOK_SECRET_PRODUCT=
STRIPE_WEBHOOK_SECRET_SUBSCRIBE=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Social login ----------------------------------------------------------
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=

# Native Google Sign-In (mobile app) — reuses SOCIAL_AUTH_GOOGLE_OAUTH2_KEY
# as the expected id_token audience; only set these if a *separate* native
# OAuth client was issued per platform instead of using the web one as
# serverClientId.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Native Sign in with Apple (mobile app) — must be the iOS app's bundle
# identifier (e.g. com.fireprenair.app), which is the audience Apple puts
# on a native sign-in's identity token.
APPLE_SIGN_IN_CLIENT_ID=

# --- AI providers ----------------------------------------------------------
# home/views.py builds an OpenAI client at import time, so a missing key stops
# the whole site from starting, not just one feature.
OPENAI_API_KEY=
GROQ_API=
LEONARDO_API_KEY=
